{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "DEPLOYMENT.md", "CHANGELOG.md", "docs"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/farm-dashboard.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Expires", "value": "0" }
        ]
      }
    ]
  }
}
